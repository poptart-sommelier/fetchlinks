# Fetchlinks publisher environment -- copy to runtime/publisher.env, mode 0600.
#
# Read only by fetchlinks-publish.service and fetchlinks-retain.service. The
# collector unit deliberately has no EnvironmentFile at all, so this credential
# never enters the process that fetches from several hundred untrusted sites.
#
# Use the fetchlinks_publisher role, not the database owner: the publisher can
# write content and read the catalog, and can do no DDL. Use the pooled Neon
# endpoint (the host with "-pooler" before the first dot) so short-lived
# one-shot runs do not each pay for a fresh backend.
#
# systemd EnvironmentFile is not a shell: do not quote the value, do not export.

FETCHLINKS_DATABASE_URL=postgresql://fetchlinks_publisher:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
