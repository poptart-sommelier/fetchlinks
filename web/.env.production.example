# Pooled Neon connection string for the fetchlinks_web role. Set this in the
# Vercel project, not in a committed file. Preview deployments must use the
# development branch, never these production credentials.
DATABASE_URL=postgresql://fetchlinks_web:__PASSWORD__@__NEON_POOLED_HOST__/fetchlinks?sslmode=require

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Credentials for the /admin/* routes (HTTP Basic). Leave unset to disable.
FETCHLINKS_ADMIN_USER=admin
FETCHLINKS_ADMIN_PASS=change-me