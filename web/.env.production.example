# Absolute path to the SQLite database written by the fetchlinks ingestion app.
FETCHLINKS_DB=/opt/fetchlinks/ingest/db/fetchlinks.db

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Credentials for the /admin/* routes (HTTP Basic). Leave unset to disable.
FETCHLINKS_ADMIN_USER=admin
FETCHLINKS_ADMIN_PASS=change-me