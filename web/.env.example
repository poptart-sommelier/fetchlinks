# PostgreSQL connection string for the fetchlinks database.
#
# In development this can be any PostgreSQL for psql and migrations, but the
# application talks to Neon over HTTP, so `npm run dev` needs a Neon branch —
# use the development branch, never production.
DATABASE_URL=postgresql://fetchlinks_web:password@ep-example.eu-west-2.aws.neon.tech/fetchlinks?sslmode=require

# Used by `npm run test` to run the query suites against a throwaway database.
# These connect over TCP, so a local container works. Unset it and the
# integration suites skip.
FETCHLINKS_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fetchlinks_web_test
